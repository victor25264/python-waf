         {
            "id": "942160",
            "name": "Detects blind sqli tests using sleep() or benchmark()",
            "version": 1,
            "type": 0,
            "logic": "(?i:sleep\\(\\s*?\\d*?\\s*?\\)|benchmark\\(.*?\\,.*?\\))",
            "enable": true,
